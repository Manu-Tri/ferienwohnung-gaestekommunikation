---
/**
 * Vorlage für Regionsseiten. Jede Datei in inhalte/regionen/ wird zu einer Seite,
 * z. B. inhalte/regionen/mosel.yaml  ->  /mosel
 */
import Basis from "../layouts/Basis.astro";
import Hero from "../components/Hero.astro";
import Laufband from "../components/Laufband.astro";
import Problem from "../components/Problem.astro";
import Gaestereise from "../components/Gaestereise.astro";
import Persoenlich from "../components/Persoenlich.astro";
import Ablauf from "../components/Ablauf.astro";
import Vergleich from "../components/Vergleich.astro";
import Ergebnisse from "../components/Ergebnisse.astro";
import Preise from "../components/Preise.astro";
import Anfrageformular from "../components/Anfrageformular.astro";
import FAQ from "../components/FAQ.astro";
import Abschluss from "../components/Abschluss.astro";
import StickyCTA from "../components/StickyCTA.astro";
import { regionen, site } from "../config/laden";
import { faqSeite, service } from "../config/jsonld";
import type { Region } from "../config/schema";
import { nurFertig } from "../config/platzhalter";

export function getStaticPaths() {
  return regionen.map((region) => ({ params: { region: region.slug }, props: { region } }));
}

const { region } = Astro.props as { region: Region };
const url = new URL(`/${region.slug}`, Astro.site).href;
// Unfertige Regionstexte (Platzhalter in eckigen Klammern) nicht anzeigen
const einleitung = nurFertig(region.einleitung);
const partner = nurFertig(region.partner_text);
const jsonld = [service(region.einsatzgebiet, region.seo_beschreibung, url), faqSeite(site.faq.fragen)];
---

<Basis titel={region.seo_titel} beschreibung={region.seo_beschreibung} jsonld={jsonld} lokaleAnker>
  <Hero titel={region.titel} unterzeile={region.unterzeile} />
  <Laufband art="punkte" punkte={site.laufband.punkte} beschriftung="Das Wichtigste in Kürze" />
  {
    (einleitung || partner) && (
      <section class="abschnitt border-t border-linie bg-karte" aria-labelledby="region-titel">
        <div class="behaelter grid gap-10 md:grid-cols-2">
          <div class="reveal">
            <h2 id="region-titel" class="h2">{region.einleitung_titel}</h2>
            {einleitung && <p class="mt-5 text-lg text-leise">{einleitung}</p>}
          </div>
          {partner && (
            <div class="reveal rounded-xl border border-linie bg-flaeche p-7">
              <h3 class="text-xl">{region.partner_titel}</h3>
              <p class="mt-3 text-leise">{partner}</p>
            </div>
          )}
        </div>
      </section>
    )
  }
  <Problem />
  <Gaestereise />
  <Persoenlich />
  <Ablauf />
  <Vergleich />
  <Ergebnisse />
  <Preise />
  <Anfrageformular region={region.name} />
  <FAQ />
  <Abschluss />
  <StickyCTA slot="ende" />
</Basis>
