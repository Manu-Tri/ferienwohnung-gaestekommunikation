---
import { istVorschau, ohneBasis, pfad } from "../config/pfad";
import "../styles/global.css";
import schriftLatin from "@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../config/laden";

interface Props {
  titel: string;
  beschreibung: string;
  /** Fokusseite ohne Hauptnavigation (z. B. /inserats-check) */
  fokus?: boolean;
  noindex?: boolean;
  jsonld?: Record<string, unknown>[];
  /** Seite enthält alle Abschnitte der Startseite (Navigation bleibt auf der Seite) */
  lokaleAnker?: boolean;
}

const { titel, beschreibung, fokus = false, noindex = false, jsonld = [], lokaleAnker = false } = Astro.props;
const kanonisch = new URL(Astro.url.pathname, Astro.site).href;
const ogBild = new URL(pfad("/og.png"), Astro.site).href;
const robots = istVorschau ? "noindex, nofollow" : noindex ? "noindex, follow" : null;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titel}</title>
    <meta name="description" content={beschreibung} />
    <link rel="canonical" href={kanonisch} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="theme-color" content="#fffaf3" />
    <link rel="icon" href={pfad("/favicon.svg")} type="image/svg+xml" />
    <link rel="preload" href={schriftLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={site.marke.name} />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:url" content={kanonisch} />
    <meta property="og:image" content={ogBild} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonld.map((daten) => <script type="application/ld+json" set:html={JSON.stringify(daten)} />)}

    <script is:inline>
      if ("IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("reveal-an");
      }
    </script>
    {
      site.analytics.plausible && (
        <script is:inline defer data-domain={site.analytics.plausible_domain} src="https://plausible.io/js/script.js" />
      )
    }
  </head>
  <body class="min-h-screen pb-20 md:pb-0">
    <a
      href="#inhalt"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-karte focus:px-4 focus:py-2"
      >Zum Inhalt springen</a
    >
    <Header fokus={fokus} lokal={lokaleAnker || ohneBasis(Astro.url.pathname) === "/"} />
    <main id="inhalt">
      <slot />
    </main>
    <Footer />
    <slot name="ende" />
    <script>
      import "../scripts/quelle";
      import "../scripts/reveal";
    </script>
  </body>
</html>
