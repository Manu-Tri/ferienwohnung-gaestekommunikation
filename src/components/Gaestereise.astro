---
import { site } from "../config/laden";
import Haken from "./Haken.astro";
import Kopf from "./Kopf.astro";
const g = site.gaestereise;

// Einfache Symbole je Phase: Schlüssel, Sprechblase, Stern
const symbole = [
  "M14.5 4a5.5 5.5 0 0 0-5.2 7.3L3 17.6V21h3.4v-2h2v-2h2l1.3-1.3A5.5 5.5 0 1 0 14.5 4zm1.5 5.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z",
  "M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H11l-4.5 4v-4h0A2.5 2.5 0 0 1 4 13.5z",
  "M12 2.8l2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17l-5.6 3 1.1-6.2L3 9.4l6.2-.9z",
];
---

<section id="betreuung" class="abschnitt" aria-labelledby="betreuung-titel">
  <div class="behaelter">
    <Kopf id="betreuung-titel" kicker={g.kicker} titel={g.titel} text={g.text} />

    <div class="phasen reveal relative mt-14">
      <!-- Verbindungslinie, füllt sich beim Einblenden von links nach rechts -->
      <div class="phasen-linie absolute top-7 right-[16%] left-[16%] hidden h-1 overflow-hidden rounded-full bg-linie md:block" aria-hidden="true">
        <span class="block h-full w-full origin-left rounded-full bg-akzent"></span>
      </div>
      <ol class="relative grid gap-6 md:grid-cols-3">
        {
          g.phasen.map((phase, i) => (
            <li class="phase group flex flex-col items-center text-center md:items-stretch md:text-left" style={`--i:${i}`}>
              <span class="phase-symbol relative z-10 mx-auto grid size-14 place-items-center rounded-full bg-akzent text-auf-akzent ring-4 ring-flaeche shadow-[0_8px_24px_-8px_rgb(26_127_69/0.7)]">
                <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
                  <path d={symbole[i % symbole.length]} fill="currentColor" />
                </svg>
              </span>
              <div
                class:list={[
                  "phase-karte karte mt-5 w-full flex-1 p-6 transition duration-300 group-hover:shadow-[0_20px_40px_-20px_rgb(28_26_23/0.25)] md:p-7",
                  i === g.phasen.length - 1 && "border-2 border-akzent",
                ]}
              >
                <p class="hand text-xl text-akzent-text">Phase {i + 1}</p>
                <h3 class="mt-1 text-xl">{phase.titel}</h3>
                <ul class="mt-5 space-y-3 text-left">
                  {phase.punkte.map((punkt, j) => (
                    <li class="phase-punkt flex items-start gap-2.5" style={`--j:${j}`}>
                      <Haken class="mt-1" />
                      {punkt}
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  /* Animationen nur, wenn Bewegung erlaubt ist (Klasse "reveal-an") */
  :global(.reveal-an) .phasen.reveal {
    opacity: 1;
    transform: none;
  }
  :global(.reveal-an) .phasen-linie span {
    transform: scaleX(0);
    transition: transform 1.4s cubic-bezier(0.6, 0, 0.2, 1) 0.2s;
  }
  :global(.reveal-an) .phase-symbol {
    transform: scale(0.4);
    opacity: 0;
    transition:
      transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 0.3s;
    transition-delay: calc(var(--i) * 0.45s);
  }
  :global(.reveal-an) .phase-karte {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.6s ease,
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.3s;
    transition-delay: calc(var(--i) * 0.45s + 0.1s);
  }
  :global(.reveal-an) .phase-punkt {
    opacity: 0;
    transform: translateX(-10px);
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
    transition-delay: calc(var(--i) * 0.45s + 0.45s + var(--j) * 0.12s);
  }
  :global(.reveal-an) .phasen.sichtbar .phasen-linie span {
    transform: scaleX(1);
  }
  :global(.reveal-an) .phasen.sichtbar .phase-symbol {
    transform: none;
    opacity: 1;
  }
  :global(.reveal-an) .phasen.sichtbar .phase-karte {
    opacity: 1;
    transform: none;
  }
  :global(.reveal-an) .phasen.sichtbar .phase-punkt {
    opacity: 1;
    transform: none;
  }
  /* Nach dem Einblenden: Hover ohne Verzögerung */
  :global(.reveal-an) .phasen.sichtbar .phase:hover .phase-karte {
    transition-delay: 0s;
    transform: translateY(-6px);
  }
  /* Letzte Phase (Nachkontakt) pulsiert einmal sanft, um Aufmerksamkeit zu bekommen */
  :global(.reveal-an) .phasen.sichtbar .phase:last-child .phase-symbol {
    animation: puls 1.6s ease-out 1.6s 2;
  }
  @keyframes puls {
    0% {
      box-shadow: 0 0 0 0 rgb(60 207 117 / 0.55);
    }
    100% {
      box-shadow: 0 0 0 18px rgb(60 207 117 / 0);
    }
  }
</style>
