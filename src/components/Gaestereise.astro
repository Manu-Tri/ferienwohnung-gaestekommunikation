---
import { site } from "../config/laden";
import Kopf from "./Kopf.astro";
const g = site.gaestereise;
---

<section id="betreuung" class="abschnitt" aria-labelledby="betreuung-titel">
  <div class="behaelter flex flex-col gap-[clamp(1.75rem,4vw,3.5rem)]">
    <Kopf id="betreuung-titel" titel={g.titel} text={g.text} />
    <ol class="grid gap-x-[clamp(1rem,2vw,1.5rem)] gap-y-10 md:grid-cols-3">
      {
        g.phasen.map((phase, i) => (
          <li class="reveal flex flex-col gap-4 border-t-[3px] border-tinte pt-5">
            <div class="flex items-baseline gap-3">
              <span class="font-display text-[clamp(2.5rem,4.2vw,3.4rem)] leading-none font-extrabold text-akzent" aria-hidden="true">
                {i + 1}
              </span>
              <h3 class="text-[clamp(1.25rem,2vw,1.5rem)]">{phase.titel}</h3>
            </div>
            <ul class="haken-liste flex flex-col gap-2.5 leading-snug text-leise">
              {phase.punkte.map((punkt) => (
                <li>
                  <span>{punkt}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>
