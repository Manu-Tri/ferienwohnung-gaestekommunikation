---
import { pfad } from "../config/pfad";
import { site } from "../config/laden";
import LogoZeichen from "./LogoZeichen.astro";
---

<a href={pfad("/")} class="group flex items-center gap-2 text-text no-underline" aria-label={`${site.marke.name}, zur Startseite`}>
  <LogoZeichen class="transition-transform duration-300 group-hover:-rotate-6" />
  <span class="logo-wort text-[1.45rem] leading-none">{site.marke.name.toLowerCase()}</span>
</a>

<style>
  .logo-wort {
    font-weight: 820;
    letter-spacing: -0.045em;
    padding-bottom: 0.12em;
  }
</style>
