---
import { pfad } from "../config/pfad";
import { site } from "../config/laden";
---

<a href={pfad("/")} class="flex items-center gap-2.5 font-semibold text-text no-underline" aria-label={`${site.marke.name}, zur Startseite`}>
  <svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true" class="shrink-0">
    <!-- Die Sprechblase ist das Haus mit Giebeldach, Tür und Sprossenfenster sind ausgespart, der Zipfel ist der Weg zur Tür -->
    <path
      fill="var(--akzent)"
      fill-rule="evenodd"
      d="M14.6 2.9Q16 1.9 17.4 2.9L28.9 10.6Q30 11.4 30 12.8V17a7 7 0 0 1-7 7h-7c-2.5 0-3 2-4.5 4-.7 1-1.3 2-1.5 3H4.5c1.5-2.5 4.5-4 4.5-7a7 7 0 0 1-7-7v-4.2q0-1.4 1.1-2.2zM9.5 15a2 2 0 0 1 4 0v6.5h-4zM18 12h3v3h-3zM22 12h3v3h-3zM18 16h3v3h-3zM22 16h3v3h-3z"
    ></path>
  </svg>
  <span class="text-[1.05rem]">{site.marke.name}</span>
</a>
