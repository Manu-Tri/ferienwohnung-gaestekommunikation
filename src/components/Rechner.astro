---
/** Kompakter Rechner als Seitenkarte (wird im Problem-Abschnitt neben den Karten angezeigt). */
import { site } from "../config/laden";
import { euro, rechnen, zahl } from "../scripts/rechnen";

const r = site.rechner;
const preis = site.preise.pro_buchung;
const start = rechnen({
  objekte: r.start_objekte,
  buchungenProMonat: r.start_buchungen,
  buchungswert: r.start_buchungswert,
  anteilProzent: r.start_anteil,
  preisProBuchung: preis,
});

const f_liste = [
  { id: "objekte", label: r.label_objekte, wert: r.start_objekte, min: 1, max: 20, schritt: 1 },
  { id: "buchungen", label: r.label_buchungen, wert: r.start_buchungen, min: 0, max: 100, schritt: 1 },
  { id: "buchungswert", label: r.label_buchungswert, wert: r.start_buchungswert, min: 50, max: 2000, schritt: 10 },
  { id: "anteil", label: r.label_anteil, wert: r.start_anteil, min: 0, max: 50, schritt: 1 },
];
---

<aside id="rechner" class="rechner karte overflow-hidden" data-preis={preis} aria-labelledby="rechner-titel">
  <div class="p-5 md:p-6">
    <h3 id="rechner-titel" class="text-lg">{r.titel}</h3>
    <p class="mt-1 text-sm text-leise">{r.intro}</p>
    <form class="mt-4 space-y-2.5 md:space-y-3.5" aria-label="Eingaben für die Beispielrechnung" onsubmit="return false">
      {
        f_liste.map((f) => (
          <div>
            <div class="flex items-center justify-between gap-3">
              <label for={`r-${f.id}`} class="text-sm font-medium leading-snug">
                {f.label}
              </label>
              <input
                type="number"
                id={`r-${f.id}`}
                name={f.id}
                data-feld={f.id}
                min={f.min}
                max={f.max}
                step={f.schritt}
                value={f.wert}
                inputmode="numeric"
                class="w-20 shrink-0 rounded-lg border-[1.5px] border-rahmen bg-flaeche px-2 py-1.5 text-right text-base tabular-nums"
              />
            </div>
            <input
              type="range"
              data-feld={f.id}
              min={f.min}
              max={f.max}
              step={f.schritt}
              value={f.wert}
              aria-hidden="true"
              tabindex="-1"
              class="regler mt-1 w-full"
            />
          </div>
        ))
      }
    </form>
  </div>
  <div class="bg-akzent-hell p-5 md:p-6">
    <dl class="grid grid-cols-2 gap-4" aria-live="polite" aria-atomic="true">
      <div>
        <dt class="text-sm font-medium">{r.ergebnis_verlust}</dt>
        <dd class="mt-1 text-2xl font-semibold tracking-tight tabular-nums" data-aus="verlust">{euro(start.verlorenerUmsatzJahr)}</dd>
        <dd class="text-xs text-leise"><span data-aus="buchungen">{zahl(start.verloreneBuchungenJahr)}</span> Buchungen</dd>
      </div>
      <div>
        <dt class="text-sm font-medium">{r.ergebnis_kosten}</dt>
        <dd class="mt-1 text-2xl font-semibold tracking-tight tabular-nums" data-aus="kosten">{euro(start.kostenJahr)}</dd>
      </div>
    </dl>
    <p class="mt-3 text-xs text-leise">{r.hinweis}</p>
    <a href="#anfrage" data-anliegen="test" class="knopf knopf-primaer mt-4 w-full !min-h-11 text-[0.95rem]">{r.cta}</a>
  </div>
</aside>

<script>
  import { euro, rechnen, zahl } from "../scripts/rechnen";

  document.querySelectorAll<HTMLElement>(".rechner").forEach((box) => {
    const preis = Number(box.dataset.preis);
    const wert = (id: string) => Number(box.querySelector<HTMLInputElement>(`input[type=number][data-feld="${id}"]`)?.value);
    const ausgabe = (name: string, text: string) => {
      const el = box.querySelector(`[data-aus="${name}"]`);
      if (el) el.textContent = text;
    };
    box.addEventListener("input", (ereignis) => {
      const quelle = ereignis.target as HTMLInputElement;
      box.querySelectorAll<HTMLInputElement>(`input[data-feld="${quelle.dataset.feld}"]`).forEach((partner) => {
        if (partner !== quelle) partner.value = quelle.value;
      });
      const e = rechnen({
        objekte: wert("objekte"),
        buchungenProMonat: wert("buchungen"),
        buchungswert: wert("buchungswert"),
        anteilProzent: wert("anteil"),
        preisProBuchung: preis,
      });
      ausgabe("verlust", euro(e.verlorenerUmsatzJahr));
      ausgabe("buchungen", zahl(e.verloreneBuchungenJahr));
      ausgabe("kosten", euro(e.kostenJahr));
    });
  });
</script>

<style>
  /* Freundliche, gut greifbare Schieberegler in der Akzentfarbe */
  .regler {
    appearance: none;
    height: 1.75rem;
    background: transparent;
    cursor: pointer;
  }
  .regler::-webkit-slider-runnable-track {
    height: 6px;
    border-radius: 999px;
    background: var(--karte-2);
  }
  .regler::-moz-range-track {
    height: 6px;
    border-radius: 999px;
    background: var(--karte-2);
  }
  .regler::-webkit-slider-thumb {
    appearance: none;
    width: 22px;
    height: 22px;
    margin-top: -8px;
    border-radius: 50%;
    background: var(--akzent);
    border: 3px solid #fff;
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.2);
  }
  .regler::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--akzent);
    border: 3px solid #fff;
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.2);
  }
</style>
