---
/** Kompakter Rechner als Seitenkarte (wird im Problem-Abschnitt neben den Karten angezeigt). */
import { site } from "../config/laden";
import { euro, rechnen, zahl } from "../scripts/rechnen";

const r = site.rechner;
const preis = site.preise.pro_buchung;
const start = rechnen({
  objekte: r.start_objekte,
  buchungenProMonat: r.start_buchungen,
  buchungswert: r.start_buchungswert,
  anteilProzent: r.start_anteil,
  preisProBuchung: preis,
});

const felder = [
  { id: "objekte", label: r.label_objekte, wert: r.start_objekte, min: 1, schritt: 1 },
  { id: "buchungen", label: r.label_buchungen, wert: r.start_buchungen, min: 0, schritt: 1 },
  { id: "buchungswert", label: r.label_buchungswert, wert: r.start_buchungswert, min: 0, schritt: 10 },
  { id: "anteil", label: r.label_anteil, wert: r.start_anteil, min: 0, max: 100, schritt: 1 },
];
---

<aside id="rechner" class="rechner karte overflow-hidden" data-preis={preis} aria-labelledby="rechner-titel">
  <div class="p-5 md:p-6">
    <h3 id="rechner-titel" class="text-lg">{r.titel}</h3>
    <p class="mt-1 text-sm text-leise">{r.intro}</p>
    <form class="mt-4 grid grid-cols-2 gap-3" aria-label="Eingaben für die Beispielrechnung" onsubmit="return false">
      {
        felder.map((f) => (
          <label class="block text-sm font-medium leading-snug">
            {f.label}
            <input
              type="number"
              name={f.id}
              data-feld={f.id}
              min={f.min}
              max={f.max}
              step={f.schritt}
              value={f.wert}
              inputmode="numeric"
              class="mt-1.5 block w-full rounded-lg border-[1.5px] border-rahmen bg-flaeche px-3 py-2 text-right text-base tabular-nums"
            />
          </label>
        ))
      }
    </form>
  </div>
  <div class="bg-akzent-hell p-5 md:p-6">
    <dl class="grid grid-cols-2 gap-4" aria-live="polite" aria-atomic="true">
      <div>
        <dt class="text-sm font-medium">{r.ergebnis_verlust}</dt>
        <dd class="mt-1 text-2xl font-semibold tracking-tight tabular-nums" data-aus="verlust">{euro(start.verlorenerUmsatzJahr)}</dd>
        <dd class="text-xs text-leise"><span data-aus="buchungen">{zahl(start.verloreneBuchungenJahr)}</span> Buchungen</dd>
      </div>
      <div>
        <dt class="text-sm font-medium">{r.ergebnis_kosten}</dt>
        <dd class="mt-1 text-2xl font-semibold tracking-tight tabular-nums" data-aus="kosten">{euro(start.kostenJahr)}</dd>
      </div>
    </dl>
    <p class="mt-3 text-xs text-leise">{r.hinweis}</p>
    <a href="#anfrage" data-anliegen="test" class="knopf knopf-primaer mt-4 w-full !min-h-11 text-[0.95rem]">{r.cta}</a>
  </div>
</aside>

<script>
  import { euro, rechnen, zahl } from "../scripts/rechnen";

  document.querySelectorAll<HTMLElement>(".rechner").forEach((box) => {
    const preis = Number(box.dataset.preis);
    const wert = (id: string) => Number(box.querySelector<HTMLInputElement>(`input[data-feld="${id}"]`)?.value);
    const ausgabe = (name: string, text: string) => {
      const el = box.querySelector(`[data-aus="${name}"]`);
      if (el) el.textContent = text;
    };
    box.addEventListener("input", () => {
      const e = rechnen({
        objekte: wert("objekte"),
        buchungenProMonat: wert("buchungen"),
        buchungswert: wert("buchungswert"),
        anteilProzent: wert("anteil"),
        preisProBuchung: preis,
      });
      ausgabe("verlust", euro(e.verlorenerUmsatzJahr));
      ausgabe("buchungen", zahl(e.verloreneBuchungenJahr));
      ausgabe("kosten", euro(e.kostenJahr));
    });
  });
</script>
