---
import { site } from "../config/laden";

interface Props {
  /** Nur ein Knopf (Fokusseite Inserats-Check) */
  nurCheck?: boolean;
}
const { nurCheck = false } = Astro.props;
---

<div
  id="sticky-cta"
  class="fixed inset-x-0 bottom-0 z-30 translate-y-full border-t border-linie bg-karte/95 px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] backdrop-blur transition-transform duration-300 md:hidden"
  data-zustand="versteckt"
  inert
>
  <div class="flex gap-2">
    {
      nurCheck ? (
        <a href="#anfrage" data-anliegen="check" class="knopf knopf-primaer flex-1 !px-3">
          {site.cta.check_kurz} anfordern
        </a>
      ) : (
        <>
          <a href="#anfrage" data-anliegen="test" class="knopf knopf-primaer flex-1 !px-3 text-[0.95rem]">
            {site.cta.test_kurz}
          </a>
          <a href="#anfrage" data-anliegen="check" class="knopf knopf-sekundaer flex-1 !px-3 text-[0.95rem]">
            {site.cta.check_kurz}
          </a>
        </>
      )
    }
  </div>
</div>

<script>
  const leiste = document.getElementById("sticky-cta");
  const hero = document.getElementById("hero");
  const formular = document.getElementById("anfrage");
  if (leiste && "IntersectionObserver" in window) {
    let heroSichtbar = true;
    let formularSichtbar = false;
    const setzen = () => {
      const zeigen = !heroSichtbar && !formularSichtbar;
      leiste.classList.toggle("translate-y-full", !zeigen);
      leiste.toggleAttribute("inert", !zeigen);
      leiste.dataset.zustand = zeigen ? "sichtbar" : "versteckt";
    };
    const beobachter = new IntersectionObserver((eintraege) => {
      for (const e of eintraege) {
        if (e.target === hero) heroSichtbar = e.isIntersecting;
        if (e.target === formular) formularSichtbar = e.isIntersecting;
      }
      setzen();
    });
    if (hero) beobachter.observe(hero);
    else heroSichtbar = false;
    if (formular) beobachter.observe(formular);
    setzen();
  }
</script>
