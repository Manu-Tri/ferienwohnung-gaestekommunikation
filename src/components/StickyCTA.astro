---
import { site } from "../config/laden";

interface Props {
  /** Knopf für den Inserats-Check (Fokusseite) */
  nurCheck?: boolean;
}
const { nurCheck = false } = Astro.props;
---

<div
  id="sticky-cta"
  class="fixed inset-x-0 bottom-0 z-30 translate-y-full border-t border-rahmen bg-flaeche/95 px-4 pt-2.5 pb-[max(0.625rem,env(safe-area-inset-bottom))] backdrop-blur transition-transform duration-300 md:hidden"
  data-zustand="versteckt"
  inert
>
  {
    nurCheck ? (
      <a href="#anfrage" data-anliegen="check" class="knopf knopf-primaer w-full !shadow-none">
        {site.cta.check_kurz} anfordern
      </a>
    ) : (
      <a href="#anfrage" data-anliegen="test" class="knopf knopf-primaer w-full !shadow-none">
        {site.cta.test}
      </a>
    )
  }
</div>

<script>
  const leiste = document.getElementById("sticky-cta");
  const hero = document.getElementById("hero");
  // Leiste ausblenden, solange Hero, Formular oder ein Bereich mit eigenem großen Knopf (data-ohne-leiste) sichtbar ist
  const verdecker = [document.getElementById("anfrage"), ...document.querySelectorAll<HTMLElement>("[data-ohne-leiste]")].filter(
    (el): el is HTMLElement => el !== null,
  );
  if (leiste && "IntersectionObserver" in window) {
    let heroSichtbar = true;
    const sichtbar = new Set<Element>();
    const setzen = () => {
      const zeigen = !heroSichtbar && sichtbar.size === 0;
      leiste.classList.toggle("translate-y-full", !zeigen);
      leiste.toggleAttribute("inert", !zeigen);
      leiste.dataset.zustand = zeigen ? "sichtbar" : "versteckt";
    };
    const beobachter = new IntersectionObserver((eintraege) => {
      for (const e of eintraege) {
        if (e.target === hero) heroSichtbar = e.isIntersecting;
        else if (e.isIntersecting) sichtbar.add(e.target);
        else sichtbar.delete(e.target);
      }
      setzen();
    });
    if (hero) beobachter.observe(hero);
    else heroSichtbar = false;
    verdecker.forEach((el) => beobachter.observe(el));
    setzen();
  }
</script>
