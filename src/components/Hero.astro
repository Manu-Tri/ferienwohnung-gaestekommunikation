---
import { site } from "../config/laden";
import ChatDemo from "./ChatDemo.astro";
import Haken from "./Haken.astro";

interface Props {
  titel?: string;
  unterzeile?: string;
  kicker?: string;
}
const { titel = site.hero.titel, unterzeile = site.hero.unterzeile, kicker = site.hero.kicker } = Astro.props;
// Zweiten Satz der Überschrift mit Textmarker hervorheben
const trenner = titel.indexOf(". ");
const satz1 = trenner > 0 ? titel.slice(0, trenner + 1) : titel;
const satz2 = trenner > 0 ? titel.slice(trenner + 2) : "";
---

<section id="hero" class="behaelter grid items-center gap-10 pt-8 pb-10 md:pt-14 md:pb-16 lg:grid-cols-[1.3fr_1fr] lg:gap-14">
  <div>
    {
      kicker && (
        <p class="inline-flex items-center gap-2 rounded-full border border-linie bg-karte px-3.5 py-1.5 text-sm font-semibold shadow-sm">
          <span class="relative flex size-2.5" aria-hidden="true">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-akzent-leuchtend opacity-75 motion-reduce:animate-none" />
            <span class="relative inline-flex size-2.5 rounded-full bg-akzent" />
          </span>
          {kicker}
        </p>
      )
    }
    <h1 class="mt-5 text-[2.1rem] leading-[1.08] sm:text-5xl lg:text-[3.4rem]">
      {satz1}
      {satz2 && <><br class="hidden sm:inline" /> <span class="marker">{satz2}</span></>}
    </h1>
    <p class="mt-5 max-w-[38rem] text-[1.075rem] text-leise md:mt-6 md:text-xl">{unterzeile}</p>
    <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap md:mt-8">
      <a href="#anfrage" data-anliegen="test" class="knopf knopf-primaer text-[1.05rem]">{site.cta.test}</a>
      <a href="#anfrage" data-anliegen="check" class="knopf knopf-sekundaer text-[1.05rem]">{site.cta.check}</a>
    </div>
    <ul class="mt-7 flex flex-wrap gap-x-5 gap-y-2.5 text-[0.95rem] font-medium" aria-label="Das Wichtigste in Kürze">
      {
        site.hero.vertrauen.map((punkt) => (
          <li class="flex items-center gap-2">
            <Haken />
            {punkt}
          </li>
        ))
      }
    </ul>
  </div>
  <div>
    <ChatDemo />
    {
      site.hero.notiz && (
        <p class="hand mt-1 mr-3 ml-auto flex w-fit max-w-[17rem] -rotate-2 items-end gap-1.5 text-right text-[1.4rem] leading-[1.1] text-akzent-text sm:mr-8">
          <span>{site.hero.notiz}</span>
          <svg viewBox="0 0 48 44" width="40" height="37" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="mb-4 shrink-0">
            <path d="M4 40C22 38 36 28 42 7" />
            <path d="M42 7l-8.5 4.5M42 7l2.5 9.5" />
          </svg>
        </p>
      )
    }
  </div>
</section>

<style>
  .marker {
    background: linear-gradient(transparent 60%, #b6ebc6 60%, #b6ebc6 94%, transparent 94%);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    padding-inline: 0.06em;
  }
</style>
