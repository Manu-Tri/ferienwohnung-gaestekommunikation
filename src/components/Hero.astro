---
import { site } from "../config/laden";
import ChatDemo from "./ChatDemo.astro";
import Haken from "./Haken.astro";

interface Props {
  titel?: string;
  unterzeile?: string;
}
const { titel = site.hero.titel, unterzeile = site.hero.unterzeile } = Astro.props;
---

<section id="hero" class="behaelter grid items-center gap-12 pt-10 pb-16 md:pt-16 md:pb-24 lg:grid-cols-[1.15fr_1fr] lg:gap-16">
  <div>
    <h1 class="text-[2.15rem] sm:text-5xl lg:text-[3.4rem]">{titel}</h1>
    <p class="mt-6 max-w-[38rem] text-lg text-leise md:text-xl">{unterzeile}</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <a href="#anfrage" data-anliegen="test" class="knopf knopf-primaer text-[1.05rem]">{site.cta.test}</a>
      <a href="#anfrage" data-anliegen="check" class="knopf knopf-sekundaer text-[1.05rem]">{site.cta.check}</a>
    </div>
    <ul class="mt-8 grid gap-x-6 gap-y-2 text-[0.95rem] text-leise sm:grid-cols-2" aria-label="Das Wichtigste in Kürze">
      {
        site.hero.vertrauen.map((punkt) => (
          <li class="flex items-center gap-2">
            <Haken />
            {punkt}
          </li>
        ))
      }
    </ul>
  </div>
  <ChatDemo />
</section>
