---
import { site } from "../config/laden";
import Kopf from "./Kopf.astro";
const a = site.ablauf;
---

<section id="ablauf" class="abschnitt" aria-labelledby="ablauf-titel">
  <div class="behaelter">
    <Kopf id="ablauf-titel" kicker={a.kicker} titel={a.titel} />
    <ol class="mt-10 grid gap-4 md:mt-12 md:grid-cols-3 md:gap-5">
      {
        a.schritte.map((schritt, i) => (
          <li class="karte reveal p-5 md:p-8">
            <div class="flex items-center justify-between">
              <span class="grid size-11 place-items-center rounded-full bg-tinte text-lg font-bold text-white" aria-hidden="true">
                {i + 1}
              </span>
              <span class="rounded-full bg-akzent-hell px-3 py-1 text-sm font-semibold text-akzent-text">{schritt.dauer}</span>
            </div>
            <h3 class="mt-5 text-xl">
              <span class="sr-only">Schritt {i + 1}: </span>
              {schritt.titel}
            </h3>
            <p class="mt-3 text-leise">{schritt.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
