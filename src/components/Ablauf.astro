---
import { site } from "../config/laden";
import Kopf from "./Kopf.astro";
const a = site.ablauf;
---

<section id="ablauf" class="abschnitt" aria-labelledby="ablauf-titel">
  <div class="behaelter flex flex-col gap-[clamp(1.75rem,4vw,3.5rem)]">
    <Kopf id="ablauf-titel" kicker={a.kicker} titel={a.titel} />
    <ol class="grid gap-[clamp(0.75rem,1.6vw,1.25rem)] md:grid-cols-3">
      {
        a.schritte.map((schritt, i) => {
          const letzter = i === a.schritte.length - 1;
          return (
            <li class:list={["reveal flex flex-col gap-3 rounded-3xl p-[clamp(1.375rem,2.6vw,2rem)]", letzter ? "bg-akzent text-white" : "bg-karte"]}>
              <div class="flex items-center justify-between gap-3">
                <span
                  class:list={[
                    "font-display grid size-11 place-items-center rounded-full text-xl font-extrabold",
                    letzter ? "bg-flaeche text-tinte" : "bg-tinte text-auf-tinte",
                  ]}
                  aria-hidden="true"
                >
                  {i + 1}
                </span>
                {schritt.hinweis && (
                  <span class:list={["hand text-[1.5rem] leading-none", letzter ? "text-gold" : "text-akzent-text"]}>{schritt.hinweis}</span>
                )}
              </div>
              <h3 class="mt-1 text-[1.375rem]">
                <span class="sr-only">Schritt {i + 1}: </span>
                {schritt.titel}
              </h3>
              <p class={letzter ? "text-mint-hell" : "text-leise"}>{schritt.text}</p>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
