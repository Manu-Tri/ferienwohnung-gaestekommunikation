---
/** Wie wir arbeiten (links) und wer hinter dem Angebot steht (rechts). */
import { site } from "../config/laden";
import { pfad } from "../config/pfad";
const p = site.persoenlich;
---

{
  p.sichtbar && (
    <section id="team" class="bg-sand" aria-labelledby="team-titel">
      <div class="behaelter abschnitt grid items-center gap-[clamp(2rem,5vw,4.5rem)] md:grid-cols-2">
        <div class="reveal flex flex-col gap-5">
          {p.kicker && <p class="kicker">{p.kicker}</p>}
          <h2 id="team-titel" class="h2 !mt-0">
            {p.titel.includes(". ") ? (
              <>
                {p.titel.slice(0, p.titel.indexOf(". ") + 1)} <span class="betont">{p.titel.slice(p.titel.indexOf(". ") + 2)}</span>
              </>
            ) : (
              p.titel
            )}
          </h2>
          <p class="max-w-[35rem] text-[clamp(1rem,1.5vw,1.19rem)] leading-relaxed text-leise">{p.einleitung}</p>
          <ul class="grid max-w-[32.5rem] grid-cols-2 gap-2.5">
            {p.themen.map((thema) => (
              <li class="rounded-[0.875rem] bg-flaeche px-4 py-3.5 font-bold">{thema}</li>
            ))}
          </ul>
          {p.themen_hinweis && <p class="text-[0.94rem] font-semibold text-leise">{p.themen_hinweis}</p>}
        </div>

        <figure class="reveal flex w-full max-w-[32.5rem] flex-col gap-4">
          {p.foto ? (
            <img
              src={pfad(p.foto)}
              alt={p.foto_alt}
              width="640"
              height="544"
              loading="lazy"
              decoding="async"
              class="foto aspect-[4/3.4] max-h-[27.5rem] w-full object-cover"
            />
          ) : (
            <div class="foto platzhalter flex aspect-[4/3.4] max-h-[27.5rem] items-end p-5">
              <span class="rounded-md bg-sand px-2 py-1 font-mono text-sm text-[#5f5440]">{p.foto_platzhalter}</span>
            </div>
          )}
          <figcaption class="flex flex-col gap-1">
            <span class="font-display text-[1.19rem] font-bold">
              {p.unterschrift}, {p.rolle}
            </span>
            {p.text.map((absatz) => (
              <span class="leading-relaxed text-leise">{absatz}</span>
            ))}
          </figcaption>
        </figure>
      </div>
    </section>
  )
}

<style>
  .foto {
    border-radius: 180px 24px 24px 24px;
  }
  .platzhalter {
    background: repeating-linear-gradient(135deg, var(--sand-dunkel) 0 10px, #dacdb3 10px 20px);
  }
</style>
