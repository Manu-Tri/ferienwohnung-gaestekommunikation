---
/** Wie wir arbeiten (links) und wer hinter dem Angebot steht (rechts). */
import { site } from "../config/laden";
import { pfad } from "../config/pfad";
import { hatPlatzhalter } from "../config/platzhalter";
const p = site.persoenlich;
// Die Person erscheint erst, wenn Name, Rolle und Text echt ausgefüllt sind
const personFertig = ![p.unterschrift, p.rolle, ...p.text].some(hatPlatzhalter);
const fotoFertig = Boolean(p.foto) && !hatPlatzhalter(p.foto_alt);
---

{
  p.sichtbar && (
    <section id="team" class="bg-sand" aria-labelledby="team-titel">
      <div class:list={["behaelter abschnitt grid items-center gap-[clamp(2rem,5vw,4.5rem)]", personFertig && "md:grid-cols-2"]}>
        <div class="reveal flex flex-col gap-5">
          <h2 id="team-titel" class="h2 !mt-0">
            {p.titel}
          </h2>
          <p class="max-w-[35rem] text-[clamp(1rem,1.5vw,1.19rem)] leading-relaxed text-leise">{p.einleitung}</p>
          <ul class="grid max-w-[32.5rem] grid-cols-2 gap-2.5">
            {p.themen.map((thema) => (
              <li class="rounded-lg bg-flaeche px-4 py-3.5 font-bold">{thema}</li>
            ))}
          </ul>
          {p.themen_hinweis && <p class="text-[0.94rem] font-semibold text-leise">{p.themen_hinweis}</p>}
        </div>

        {personFertig && (
        <figure class="reveal flex w-full max-w-[32.5rem] flex-col gap-4">
          {fotoFertig && (
            <img
              src={pfad(p.foto)}
              alt={p.foto_alt}
              width="640"
              height="544"
              loading="lazy"
              decoding="async"
              class="foto aspect-[4/3.4] max-h-[27.5rem] w-full object-cover"
            />
          )}
          <figcaption class="flex flex-col gap-1">
            <span class="font-display text-[1.19rem] font-bold">
              {p.unterschrift}, {p.rolle}
            </span>
            {p.text.map((absatz) => (
              <span class="leading-relaxed text-leise">{absatz}</span>
            ))}
          </figcaption>
        </figure>
        )}
      </div>
    </section>
  )
}

<style>
  /* Oben gerundet wie eine Haustür */
  .foto {
    border-radius: 999px 999px 0.75rem 0.75rem / 260px 260px 0.75rem 0.75rem;
  }
</style>
