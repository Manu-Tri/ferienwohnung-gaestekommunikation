---
/** Einheitlicher Abschnittskopf: Überschrift, optional Einleitung. */
interface Props {
  id: string;
  titel: string;
  text?: string;
  zentriert?: boolean;
}
const { id, titel, text, zentriert = false } = Astro.props;
---

<div class:list={["reveal flex max-w-[51rem] flex-col", zentriert && "mx-auto items-center text-center"]}>
  <h2 id={id} class="h2">{titel}</h2>
  {text && <p class="mt-4 max-w-[36rem] text-[clamp(1rem,1.5vw,1.19rem)] leading-relaxed text-leise md:mt-5">{text}</p>}
</div>
