---
import { pfad } from "../config/pfad";
import { site } from "../config/laden";
import { hatPlatzhalter } from "../config/platzhalter";

interface Props {
  titel?: string;
  /** Anliegen fest vorgeben (Fokusseite Inserats-Check) */
  anliegenFest?: "test" | "check" | "agentur";
  /** Region vorbefüllen (Regionsseiten) */
  region?: string;
}
const { titel = site.anfrage.titel, anliegenFest, region = "" } = Astro.props;
const a = site.anfrage;
const f = site.formular;
const istNetlify = f.anbieter === "netlify";
// Ohne echte E-Mail-Adresse den Hinweis „schreiben Sie an …“ weglassen
const fehlerSenden = hatPlatzhalter(site.marke.email) ? a.fehler_senden.replace(/\s+oder schreiben Sie an\s+\S+?\.?$/, ".") : a.fehler_senden;
const action = istNetlify ? pfad("/danke") : f.endpunkt;
const anliegen = [
  { wert: "test", text: a.anliegen.test },
  { wert: "check", text: a.anliegen.check },
  { wert: "agentur", text: a.anliegen.agentur },
] as const;

// Segment-Umschalter für das Anliegen
const segment =
  "relative flex min-h-12 cursor-pointer items-center justify-center rounded-[0.625rem] px-1.5 py-2 text-center text-[0.875rem] leading-tight font-bold text-leise transition-colors has-checked:bg-akzent has-checked:text-auf-akzent has-focus-visible:outline-3 has-focus-visible:outline-offset-2 has-focus-visible:outline-tinte sm:text-[0.95rem]";
const kachel =
  "flex min-h-14 cursor-pointer items-center gap-3 rounded-[0.875rem] border-2 border-eingabe-rand bg-karte px-4 py-3 font-semibold transition-colors hover:border-akzent has-checked:border-akzent has-checked:bg-akzent-hell";
const eingabe =
  "mt-1.5 block w-full rounded-xl border-2 border-eingabe-rand bg-karte px-3.5 py-3 text-[max(16px,1rem)] aria-invalid:border-fehler";
const frage = "font-display text-[1.25rem] leading-snug font-bold md:text-[1.4rem]";
---

<section id="anfrage" class="abschnitt" aria-labelledby="anfrage-titel">
  <div class="behaelter grid items-start gap-[clamp(1.75rem,5vw,4.5rem)] lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]">
    <div class="flex flex-col gap-4 lg:sticky lg:top-28">
      <h2 id="anfrage-titel" class="h2 !mt-0">{titel}</h2>
      {a.untertitel && <p class="max-w-[30rem] text-[clamp(1rem,1.5vw,1.19rem)] leading-relaxed text-leise">{a.untertitel}</p>}
      {a.gruss && <p class="gruss">{a.gruss}</p>}
    </div>

    <form
      name={f.name}
      method="POST"
      action={action}
      class="anfrage rounded-xl bg-karte p-[clamp(1.25rem,3vw,2.5rem)] shadow-[0_20px_50px_rgb(29_40_51/0.08)]"
      data-anbieter={f.anbieter}
      data-schritt-text={a.schritt}
      data-fehler-senden={fehlerSenden}
      data-senden-laeuft={a.senden_laeuft}
      {...istNetlify ? { "data-netlify": "true", "netlify-honeypot": "firma_website" } : {}}
    >
      <input type="hidden" name="form-name" value={f.name} />
      <input type="hidden" name="quelle" value="direkt" data-quelle />
      <input type="hidden" name="seite" value={Astro.url.pathname} />
      <input type="hidden" name="wunschpaket" value="" data-wunschpaket />
      <p class="hidden" aria-hidden="true">
        <label>Bitte nicht ausfüllen <input name="firma_website" tabindex="-1" autocomplete="off" /></label>
      </p>

      {
        anliegenFest ? (
          <input type="hidden" name="anliegen" value={anliegenFest} />
        ) : (
          <fieldset class="mb-7">
            <legend class="mb-2.5 text-sm font-semibold">{a.anliegen_frage}</legend>
            <div class="grid grid-cols-3 gap-1 rounded-[0.875rem] bg-flaeche p-1">
              {anliegen.map((option, i) => (
                <label class={segment}>
                  <input type="radio" name="anliegen" value={option.wert} checked={i === 0} class="sr-only" />
                  <span>{option.text}</span>
                </label>
              ))}
            </div>
          </fieldset>
        )
      }

      <div class="mb-8 rounded-[0.875rem] border-2 border-akzent bg-akzent-hell px-4 py-3.5" data-wunschpaket-box hidden>
        <p class="text-sm font-semibold">{a.label_wunschpaket}</p>
        <ul class="mt-1.5 list-disc pl-5 text-sm" data-wunschpaket-liste></ul>
        <a href="#wunschpaket" class="mt-2 inline-block text-sm font-medium">{a.wunschpaket_aendern}</a>
      </div>

      <div class="nur-js mb-8">
        <p class="text-sm font-medium text-leise" data-fortschritt-text aria-live="polite">
          {a.schritt.replace("{nr}", "1")}
        </p>
        <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-sand" aria-hidden="true">
          <div style="transform: scaleX(0.25)" class="h-full w-full origin-left rounded-full bg-akzent transition-transform duration-300 ease-out" data-fortschritt-balken></div>
        </div>
      </div>

      <!-- Schritt 1 -->
      <div data-schritt data-aktiv>
        <fieldset aria-describedby="fehler-1">
          <legend class={frage}>{a.frage_objekte}</legend>
          <div class="mt-5 grid gap-2.5 sm:grid-cols-2" data-auto-weiter>
            {
              a.objekte.map((option) => (
                <label class={kachel}>
                  <input type="radio" name="objekte" value={option} required class="size-5 accent-[var(--akzent)]" data-fehler={a.fehler_auswahl} />
                  <span>{option}</span>
                </label>
              ))
            }
          </div>
        </fieldset>
        <p id="fehler-1" class="fehler mt-3 font-medium text-fehler" role="alert" data-fehler-box></p>
      </div>

      <!-- Schritt 2 -->
      <div data-schritt>
        <fieldset aria-describedby="fehler-2">
          <legend class={frage}>{a.frage_plattformen}</legend>
          <div class="mt-5 grid gap-2.5 sm:grid-cols-2" data-mindestens-eins={a.fehler_plattform}>
            {
              a.plattformen.map((option) => (
                <label class={kachel}>
                  <input type="checkbox" name="plattformen[]" value={option} class="size-5 accent-[var(--akzent)]" />
                  <span>{option}</span>
                </label>
              ))
            }
          </div>
        </fieldset>
        <p id="fehler-2" class="fehler mt-3 font-medium text-fehler" role="alert" data-fehler-box></p>
        <label class="mt-6 block font-semibold">
          {a.label_region}
          <input type="text" name="region" value={region} autocomplete="address-level2" class={eingabe} />
        </label>
      </div>

      <!-- Schritt 3 -->
      <div data-schritt>
        <fieldset aria-describedby="fehler-3">
          <legend class={frage}>{a.frage_problem}</legend>
          <div class="mt-5 grid gap-2.5" data-auto-weiter>
            {
              a.probleme.map((option) => (
                <label class={kachel}>
                  <input type="radio" name="problem" value={option} required class="size-5 accent-[var(--akzent)]" data-fehler={a.fehler_auswahl} />
                  <span>{option}</span>
                </label>
              ))
            }
          </div>
        </fieldset>
        <p id="fehler-3" class="fehler mt-3 font-medium text-fehler" role="alert" data-fehler-box></p>
        <label class="mt-6 block font-semibold">
          {a.label_problem_text}
          <textarea name="problem_text" rows="3" class={eingabe}></textarea>
        </label>
      </div>

      <!-- Schritt 4 -->
      <div data-schritt>
        <fieldset>
          <legend class={frage}>{a.frage_kontakt}</legend>
          <div class="mt-5 space-y-5">
            <div>
              <label for="f-name" class="font-semibold">{a.label_name}</label>
              <input id="f-name" type="text" name="name" required autocomplete="name" class={eingabe} data-fehler={a.fehler_name} aria-describedby="f-name-fehler" />
              <p id="f-name-fehler" class="fehler mt-2 font-medium text-fehler"></p>
            </div>
            <div>
              <label for="f-email" class="font-semibold">{a.label_email}</label>
              <input
                id="f-email"
                type="email"
                name="email"
                required
                autocomplete="email"
                inputmode="email"
                class={eingabe}
                data-fehler={a.fehler_email}
                aria-describedby="f-email-fehler"
              />
              <p id="f-email-fehler" class="fehler mt-2 font-medium text-fehler"></p>
            </div>
            <div>
              <label for="f-telefon" class="font-semibold">{a.label_telefon}</label>
              <input id="f-telefon" type="tel" name="telefon" autocomplete="tel" class={eingabe} />
            </div>
            <div>
              <label for="f-inserat" class="font-semibold">{a.label_inserat}</label>
              <input
                id="f-inserat"
                type="url"
                name="inserat"
                placeholder="https://"
                inputmode="url"
                class={eingabe}
                data-fehler={a.fehler_url}
                aria-describedby="f-inserat-hinweis f-inserat-fehler"
              />
              <p id="f-inserat-hinweis" class="mt-2 text-sm text-leise" data-nur-check hidden={anliegenFest !== "check"}>
                {a.hinweis_inserat_check}
              </p>
              <p id="f-inserat-fehler" class="fehler mt-2 font-medium text-fehler"></p>
            </div>
          </div>
        </fieldset>

        <p class="mt-7 text-sm text-leise">
          {a.datenschutz} <a href={pfad("/datenschutz")}>{a.datenschutz_link}</a>.
        </p>
        <button type="submit" class="knopf knopf-primaer mt-5 w-full text-[1.05rem] sm:w-auto" data-absenden>
          {a.absenden}
        </button>
        <p class="fehler mt-4 font-medium text-fehler" role="alert" data-sende-fehler></p>
      </div>

      <div class="nur-js mt-8 items-center justify-between gap-3 border-t border-rahmen pt-6" data-navigation>
        <button type="button" class="textlink cursor-pointer px-1 py-3" data-zurueck>{a.zurueck}</button>
        <button type="button" class="knopf knopf-primaer ml-auto" data-weiter>{a.weiter}</button>
      </div>
    </form>
  </div>
</section>

<style>
  .nur-js {
    display: none;
  }
  .anfrage[data-js] .nur-js {
    display: block;
  }
  .anfrage[data-js] [data-navigation] {
    display: flex;
  }
  /* Ohne JavaScript stehen alle Schritte untereinander */
  [data-schritt] + [data-schritt] {
    margin-top: 2.5rem;
  }
  .anfrage[data-js] [data-schritt] {
    margin-top: 0;
  }
  .anfrage[data-js] [data-schritt]:not([data-aktiv]) {
    display: none;
  }
  .fehler:empty {
    display: none;
  }
</style>

<script>
  import "../scripts/formular";
</script>
