---
import { euro, site } from "../config/laden";
import { nurFertig, ohnePlatzhalter } from "../config/platzhalter";

const p = site.preise_abschnitt;
const gp = site.preise.gruenderpreis;
const preis = site.preise.pro_buchung;
const frei = gp.plaetze_frei;
const zeigeZaehler = typeof frei === "number";
const angebote = site.angebote;
// Karten-ID für Sprungmarken aus der Navigation
const kartenId: Record<string, string> = { agentur: "agenturen" };
---

<section id="preise" class="preise relative bg-akzent text-auf-akzent" aria-labelledby="preise-titel">
  <div class="behaelter abschnitt relative flex flex-col gap-[clamp(1.75rem,4vw,3rem)]">
    <div class="grid items-end gap-[clamp(1.75rem,4vw,4rem)] lg:grid-cols-2">
      <div class="reveal flex flex-col gap-3.5">
        <p class="font-display flex flex-wrap items-baseline gap-x-4 font-extrabold">
          <span class="text-[clamp(3.25rem,7.5vw,6.5rem)] leading-[0.88] tracking-[-0.04em]">{euro(preis)}</span>
          <span class="text-[clamp(1.25rem,2vw,1.625rem)]">{p.einheit}</span>
        </p>
        <h2 id="preise-titel" class="text-[clamp(1.25rem,2vw,1.625rem)] leading-tight">{p.titel}</h2>
        <p class="text-mint-hell">{p.test_hinweis}</p>
        <p class="text-sm text-mint-hell">{p.steuer}</p>
        <ul class="mt-1 flex flex-wrap gap-2 text-sm font-semibold">
          {p.punkte.map((punkt) => <li class="rounded-full border-[1.5px] border-auf-akzent/40 px-3 py-1.5">{punkt}</li>)}
        </ul>
      </div>

      <div
        class="kosten reveal flex flex-col gap-4 rounded-xl bg-tinte p-[clamp(1.375rem,2.6vw,2rem)] text-auf-tinte"
        data-preis={preis}
        data-max={p.rechner_max}
      >
        <label for="kosten-regler" class="text-[1.06rem] font-bold">{p.rechner_frage}</label>
        <input id="kosten-regler" type="range" min="1" max={p.rechner_max} value={p.rechner_start} class="h-[44px] w-full accent-mint" />
        <div class="flex flex-wrap items-baseline justify-between gap-3" aria-live="polite">
          <span class="text-[1.06rem] font-medium"><span data-anzahl>{p.rechner_start}</span> {p.rechner_einheit}</span>
          <span class="font-display text-[clamp(2rem,3.6vw,2.75rem)] font-extrabold text-mint">
            <span data-summe>{euro(p.rechner_start * preis)}</span>{" "}
            <span class="font-sans text-base font-medium text-auf-tinte-leise">{p.rechner_zeitraum}</span>
          </span>
        </div>
      </div>
    </div>

    <div id="angebote" class="flex scroll-mt-24 flex-col gap-3.5">
      <h3 class="text-[clamp(1.375rem,2.2vw,1.75rem)]">{angebote.titel}</h3>
      <ul class="grid gap-[clamp(0.75rem,1.6vw,1.25rem)] md:grid-cols-2 xl:grid-cols-3">
        {
          angebote.karten.map((k) => {
            const dunkel = k.stil === "dunkel";
            return (
              <li
                id={kartenId[k.anliegen]}
                class:list={[
                  "reveal flex scroll-mt-24 flex-col gap-3.5 rounded-xl p-[clamp(1.375rem,2.6vw,1.875rem)]",
                  dunkel ? "bg-tinte text-auf-tinte" : "bg-flaeche text-text",
                ]}
              >
                <span
                  class:list={[
                    "self-start rounded-full px-3 py-1 text-[0.875rem] font-bold",
                    k.empfohlen ? "bg-akzent text-auf-akzent" : dunkel ? "bg-auf-tinte/15" : "bg-sand",
                  ]}
                >
                  {k.etikett}
                </span>
                <h4 lang="de" class="text-[clamp(1.25rem,2vw,1.5rem)] font-extrabold [overflow-wrap:break-word] hyphens-auto">
                  {k.titel}
                </h4>
                <p class="text-lg font-bold">{ohnePlatzhalter(k.preis)}</p>
                <ul class:list={["haken-liste flex flex-1 flex-col gap-2", dunkel ? "text-auf-tinte-leise [--haken-farbe:var(--mint)]" : "text-leise"]}>
                  {k.punkte.map((punkt) => (
                    <li>
                      <span>{punkt}</span>
                    </li>
                  ))}
                </ul>
                <a
                  href="#anfrage"
                  data-anliegen={k.anliegen}
                  class:list={["knopf mt-1 w-full", k.empfohlen ? "knopf-primaer" : dunkel ? "knopf-hell" : "knopf-dunkel"]}
                >
                  {k.cta}
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>

    <div class="reveal rounded-xl bg-flaeche p-[clamp(1.375rem,2.6vw,2rem)] text-text">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h3 class="text-xl">{p.gruenderpreis_titel}</h3>
        {
          zeigeZaehler && (
            <p class="rounded-full bg-akzent px-3.5 py-1.5 text-sm font-semibold text-auf-akzent">{p.zaehler_text.replace("{frei}", String(frei))}</p>
          )
        }
      </div>
      <p class="mt-2 text-lg">{p.gruenderpreis_text}</p>
      {zeigeZaehler && <p class="mt-1 text-sm text-leise">{p.zaehler_hinweis}</p>}

      <details class="bedingungen group mt-4 border-t border-rahmen">
        <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-4 pt-3 font-bold [&::-webkit-details-marker]:hidden">
          {p.bedingungen_aufklappen}
          <span class="plus" aria-hidden="true"></span>
        </summary>
        <div class="grid gap-x-10 gap-y-8 pt-4 pb-1 lg:grid-cols-2">
          <div>
            <h4 class="font-sans text-base font-bold">{p.test_titel}</h4>
            <dl class="mt-3 space-y-3">
              {
                p.test_bedingungen.map((b) => (
                  <div>
                    <dt class="font-semibold">{b.titel}</dt>
                    <dd class="text-leise">{ohnePlatzhalter(b.text)}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
          <div>
            <h4 class="font-sans text-base font-bold">{p.gp_titel}</h4>
            <ul class="mt-3 list-disc space-y-1.5 pl-5 text-leise">
              {p.gp_bedingungen.map((b) => <li>{ohnePlatzhalter(b)}</li>)}
            </ul>
            {(nurFertig(p.abrechnung_booking) || nurFertig(p.buchung_definition)) && (
              <div class="mt-6 space-y-2 border-t border-rahmen pt-5 text-sm text-leise">
                {nurFertig(p.abrechnung_booking) && <p>{p.abrechnung_booking}</p>}
                {nurFertig(p.buchung_definition) && <p>{p.buchung_definition}</p>}
              </div>
            )}
          </div>
        </div>
      </details>
    </div>
  </div>
</section>

<style>
  .preise {
    --fokus: var(--gold);
  }
  /* Auf hellen Karten bleibt der Fokusrahmen dunkel */
  .preise .bg-flaeche {
    --fokus: var(--tinte);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".kosten").forEach((box) => {
    const preis = Number(box.dataset.preis);
    const regler = box.querySelector<HTMLInputElement>("input[type=range]")!;
    const anzahl = box.querySelector<HTMLElement>("[data-anzahl]")!;
    const summe = box.querySelector<HTMLElement>("[data-summe]")!;
    const format = new Intl.NumberFormat("de-DE", { style: "currency", currency: "EUR", maximumFractionDigits: 0 });
    regler.addEventListener("input", () => {
      const n = Number(regler.value);
      anzahl.textContent = String(n);
      summe.textContent = format.format(n * preis);
    });
  });
</script>
