---
import { pfad } from "../config/pfad";
import { site } from "../config/laden";
import Logo from "./Logo.astro";

interface Props {
  fokus?: boolean;
  /** Abschnitte liegen auf dieser Seite */
  lokal?: boolean;
}
const { fokus = false, lokal = false } = Astro.props;
const zeigeErgebnisse = site.ergebnisse.kennzahlen.length + site.ergebnisse.stimmen.length > 0;
const navigation = zeigeErgebnisse
  ? [...site.navigation.slice(0, 2), { text: "Ergebnisse", ziel: "#ergebnisse" }, ...site.navigation.slice(2)]
  : site.navigation;
// Auf Unterseiten ohne diese Abschnitte zeigen Anker auf die Startseite
const istStart = lokal;
const ziel = (anker: string) => (istStart || !anker.startsWith("#") ? anker : pfad(`/${anker}`));
---

<header class="kopfzeile sticky top-0 z-40 bg-flaeche/90 backdrop-blur supports-[backdrop-filter]:bg-flaeche/80">
  <div class="behaelter flex h-[4.25rem] items-center justify-between gap-2 min-[360px]:gap-3 sm:gap-6 md:h-20">
    <Logo />
    {
      !fokus && (
        <>
          <nav aria-label="Hauptnavigation" class="hidden flex-1 lg:block">
            <ul class="flex items-center justify-center gap-8">
              {navigation.map((punkt) => (
                <li>
                  <a href={ziel(punkt.ziel)} class="font-medium text-leise no-underline hover:text-akzent-text">
                    {punkt.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <div class="flex items-center gap-2">
            <a
              href={istStart ? "#anfrage" : pfad("/?anliegen=test#anfrage")}
              data-anliegen="test"
              class="knopf knopf-dunkel !min-h-[44px] !rounded-full !px-4 !py-2.5 text-[0.9rem] whitespace-nowrap max-[359px]:!px-3 max-[359px]:text-[0.85rem] sm:!px-5 sm:text-[0.95rem]"
            >
              {site.cta.test_kurz}
            </a>
            <details class="relative lg:hidden">
              <summary class="grid size-[44px] cursor-pointer list-none place-items-center rounded-full border-2 border-linie [&::-webkit-details-marker]:hidden">
                <span class="sr-only">Menü</span>
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <path class="menue-zu" d="M4 7h16M4 12h16M4 17h10" />
                  <path class="menue-auf" d="M6 6l12 12M18 6L6 18" />
                </svg>
              </summary>
              <nav aria-label="Hauptnavigation mobil" class="karte absolute right-0 mt-2 w-[min(18rem,calc(100vw-2.5rem))] p-2 shadow-[0_20px_50px_-20px_rgb(24_38_28/0.35)]">
                <ul>
                  {navigation.map((punkt) => (
                    <li>
                      <a href={ziel(punkt.ziel)} class="block rounded-xl px-3 py-3 font-semibold no-underline hover:bg-flaeche">
                        {punkt.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </details>
          </div>
        </>
      )
    }
  </div>
</header>

<script>
  // Mobiles Menü schließen: nach Klick auf einen Eintrag, beim Tippen daneben und mit Escape
  document.querySelectorAll<HTMLDetailsElement>("header details").forEach((menue) => {
    menue.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) menue.open = false;
    });
    document.addEventListener("click", (e) => {
      if (menue.open && !menue.contains(e.target as Node)) menue.open = false;
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menue.open) {
        menue.open = false;
        menue.querySelector("summary")?.focus();
      }
    });
  });
</script>

<style>
  .menue-auf {
    display: none;
  }
  details[open] .menue-auf {
    display: inline;
  }
  details[open] .menue-zu {
    display: none;
  }
</style>
