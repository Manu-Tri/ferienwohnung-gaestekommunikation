---
import { pfad } from "../config/pfad";
import { site } from "../config/laden";
import Logo from "./Logo.astro";

interface Props {
  fokus?: boolean;
  /** Abschnitte liegen auf dieser Seite */
  lokal?: boolean;
}
const { fokus = false, lokal = false } = Astro.props;
const zeigeErgebnisse = site.ergebnisse.kennzahlen.length + site.ergebnisse.stimmen.length > 0;
const navigation = zeigeErgebnisse
  ? [...site.navigation.slice(0, 2), { text: "Ergebnisse", ziel: "#ergebnisse" }, ...site.navigation.slice(2)]
  : site.navigation;
// Auf Unterseiten ohne diese Abschnitte zeigen Anker auf die Startseite
const istStart = lokal;
const ziel = (anker: string) => (istStart || !anker.startsWith("#") ? anker : pfad(`/${anker}`));
---

<header class="sticky top-0 z-40 border-b border-linie/70 bg-flaeche/90 backdrop-blur supports-[backdrop-filter]:bg-flaeche/75">
  <div class="behaelter flex h-16 items-center justify-between gap-4">
    <Logo />
    {
      !fokus && (
        <>
          <nav aria-label="Hauptnavigation" class="hidden lg:block">
            <ul class="flex items-center gap-7 text-[0.95rem]">
              {navigation.map((punkt) => (
                <li>
                  <a href={ziel(punkt.ziel)} class="font-medium text-text no-underline decoration-akzent-leuchtend decoration-[3px] underline-offset-[6px] hover:underline">
                    {punkt.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <div class="flex items-center gap-2">
            <a href={istStart ? "#anfrage" : pfad("/?anliegen=test#anfrage")} data-anliegen="test" class="knopf knopf-primaer hidden !min-h-11 !px-4 text-[0.95rem] sm:inline-flex">
              {site.cta.test}
            </a>
            <details class="relative lg:hidden">
              <summary class="grid size-11 cursor-pointer list-none place-items-center rounded-full border-[1.5px] border-linie bg-karte [&::-webkit-details-marker]:hidden">
                <span class="sr-only">Menü</span>
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <path class="menue-zu" d="M4 7h16M4 12h16M4 17h10" />
                  <path class="menue-auf" d="M6 6l12 12M18 6L6 18" />
                </svg>
              </summary>
              <nav aria-label="Hauptnavigation mobil" class="karte absolute right-0 mt-2 w-[min(18rem,calc(100vw-2.5rem))] p-2 shadow-[0_20px_50px_-20px_rgb(28_26_23/0.35)]">
                <ul>
                  {navigation.map((punkt) => (
                    <li>
                      <a href={ziel(punkt.ziel)} class="block rounded-lg px-3 py-3 font-medium text-text no-underline hover:bg-karte-2">
                        {punkt.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </details>
          </div>
        </>
      )
    }
  </div>
</header>

<script>
  // Mobiles Menü nach Klick auf einen Eintrag schließen
  document.querySelectorAll<HTMLDetailsElement>("header details").forEach((menue) => {
    menue.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) menue.open = false;
    });
  });
</script>

<style>
  .menue-auf {
    display: none;
  }
  details[open] .menue-auf {
    display: inline;
  }
  details[open] .menue-zu {
    display: none;
  }
</style>
