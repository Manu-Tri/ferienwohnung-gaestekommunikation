---
/**
 * Endlos laufendes Band, reines CSS. Der Inhalt wird für die nahtlose Schleife einmal
 * wiederholt; die Wiederholung ist für Screenreader ausgeblendet.
 * Bei Mauszeiger oder Tastaturfokus hält das Band an, bei „Bewegung reduzieren“ steht es still
 * und lässt sich seitlich wischen.
 *
 * Zwei Arten: kurze Punkte (grünes Band) oder Kundenstimmen (Karten).
 */
interface Stimme {
  zitat: string;
  name: string;
  ort?: string;
  objekte?: string;
  /** Ausgedachter Mustertext: Karte trägt sichtbar das Etikett „Beispiel“ */
  beispiel?: boolean;
}
type Props =
  | { art: "punkte"; punkte: string[]; beschriftung: string; dauer?: number }
  | { art: "stimmen"; stimmen: Stimme[]; beschriftung: string; dauer?: number };

const props = Astro.props;
const dauer = props.dauer ?? (props.art === "punkte" ? 55 : 60);
// Kurze Listen auffüllen, damit eine Gruppe breiter als der Bildschirm ist
const wiederholen = <T,>(liste: T[], mindestens: number) =>
  Array.from({ length: Math.max(1, Math.ceil(mindestens / liste.length)) }, () => liste).flat();
const gruppen = [false, true];
---

<section class:list={["laufband relative overflow-hidden", props.art === "punkte" ? "bg-akzent py-3.5 text-auf-akzent" : "py-2"]} aria-label={props.beschriftung} style={`--dauer:${dauer}s`}>
  <div class="laufband-spur flex w-max">
    {
      gruppen.map((kopie) => (
        <ul class="laufband-gruppe flex shrink-0 items-stretch" aria-hidden={kopie ? "true" : undefined}>
          {props.art === "punkte"
            ? wiederholen(props.punkte, 8).map((punkt) => (
                <li class="font-display flex items-center text-[clamp(1.1rem,1.7vw,1.4rem)] font-bold whitespace-nowrap [font-stretch:72%]">
                  <span class="px-6">{punkt}</span>
                  <svg class="text-mint" viewBox="0 0 20 12" width="22" height="13" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 6.5l3.6 3.6L12 2M8.6 9.4l.7.7L16.7 2" />
                  </svg>
                </li>
              ))
            : wiederholen(props.stimmen, 4).map((s) => (
                <li class="mr-4 flex w-[min(22rem,80vw)] shrink-0">
                  <figure class="flex w-full flex-col gap-3 rounded-xl bg-karte p-6">
                    {s.beispiel && <span class="self-start rounded-full bg-sand px-2.5 py-0.5 text-[0.875rem] font-bold text-leise">Beispiel</span>}
                    <blockquote class="leading-relaxed">„{s.zitat}“</blockquote>
                    <figcaption class="mt-auto pt-1 text-sm text-leise">
                      <span class="font-display block text-base font-bold text-text">{s.name}</span>
                      {[s.ort, s.objekte].filter(Boolean).join(", ")}
                    </figcaption>
                  </figure>
                </li>
              ))}
        </ul>
      ))
    }
  </div>
  <button type="button" class="laufband-pause" aria-pressed="false" aria-label="Laufband anhalten">
    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="currentColor">
      <path class="zeichen-pause" d="M4 3h3v10H4zM9 3h3v10H9z" />
      <path class="zeichen-weiter" d="M5 3l8 5-8 5z" />
    </svg>
  </button>
</section>

<style>
  .laufband-spur {
    animation: laufen var(--dauer) linear infinite;
  }
  .laufband:hover .laufband-spur,
  .laufband.angehalten .laufband-spur {
    animation-play-state: paused;
  }
  /* Knopf zum Anhalten (WCAG 2.2.2), nur wenn sich das Band bewegt */
  .laufband-pause {
    display: none;
    position: absolute;
    inset-block: 0;
    right: 0;
    width: 3rem;
    place-items: center;
    cursor: pointer;
    color: inherit;
    background: inherit;
    box-shadow: -1rem 0 1rem -0.25rem var(--akzent);
  }
  :global(.reveal-an) .laufband-pause {
    display: grid;
  }
  .laufband-pause .zeichen-weiter,
  .laufband.angehalten .laufband-pause .zeichen-pause {
    display: none;
  }
  .laufband.angehalten .laufband-pause .zeichen-weiter {
    display: inline;
  }
  @keyframes laufen {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .laufband-pause {
      display: none !important;
    }
    .laufband {
      overflow-x: auto;
    }
    .laufband-spur {
      animation: none;
    }
    .laufband-gruppe[aria-hidden] {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".laufband").forEach((band) => {
    const knopf = band.querySelector<HTMLButtonElement>(".laufband-pause");
    knopf?.addEventListener("click", () => {
      const an = band.classList.toggle("angehalten");
      knopf.setAttribute("aria-pressed", String(an));
    });
  });
</script>
