---
import { site } from "../config/laden";
import Rechner from "./Rechner.astro";
import Kopf from "./Kopf.astro";
const p = site.problem;
---

<section class="abschnitt border-t border-linie bg-karte" aria-labelledby="problem-titel">
  <div class="behaelter">
    <Kopf id="problem-titel" kicker={p.kicker} titel={p.titel} />
    <div class="mt-10 grid items-start gap-6 md:mt-12 lg:grid-cols-[1fr_22rem]">
      <ul class="grid gap-3 sm:grid-cols-2 sm:gap-5">
        {
          p.karten.map((karte) => (
            <li class="reveal rounded-[1.25rem] border border-linie bg-flaeche p-5 md:p-7">
              <h3 class="text-lg md:text-xl">{karte.titel}</h3>
              <p class="mt-2 text-leise md:mt-3">{karte.text}</p>
            </li>
          ))
        }
      </ul>
      <div class="reveal lg:sticky lg:top-24">
        <Rechner />
      </div>
    </div>
  </div>
</section>
