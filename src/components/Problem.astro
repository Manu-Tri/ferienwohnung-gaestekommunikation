---
import { site } from "../config/laden";
import Rechner from "./Rechner.astro";
const p = site.problem;
---

<section class="abschnitt border-t border-linie bg-karte" aria-labelledby="problem-titel">
  <div class="behaelter">
    <h2 id="problem-titel" class="h2 reveal max-w-3xl">{p.titel}</h2>
    <div class="mt-12 grid items-start gap-6 lg:grid-cols-[1fr_22rem]">
      <ul class="grid gap-5 sm:grid-cols-2">
        {
          p.karten.map((karte) => (
            <li class="reveal rounded-[1.25rem] border border-linie bg-flaeche p-6 md:p-7">
              <h3 class="text-xl">{karte.titel}</h3>
              <p class="mt-3 text-leise">{karte.text}</p>
            </li>
          ))
        }
      </ul>
      <div class="reveal lg:sticky lg:top-24">
        <Rechner />
      </div>
    </div>
  </div>
</section>
