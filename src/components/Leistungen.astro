---
import { site } from "../config/laden";
import Kopf from "./Kopf.astro";
const l = site.leistungen;

// Linien-Symbole (24 × 24) in Reihenfolge der Karten; bei mehr Karten wiederholen sie sich
const symbole = [
  // Uhr
  "M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z",
  // Schlüssel
  "M15 7.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0zM12 10.5V21m0-4h3m-3-3h2",
  // Glocke / Notfall
  "M6 16V11a6 6 0 1 1 12 0v5l1.5 2h-15zM10 20.5a2 2 0 0 0 4 0",
  // Herz / Nachkontakt
  "M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z",
  // Stern / Bewertung
  "M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z",
  // Person / feste Ansprechperson
  "M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4.5 21a7.5 7.5 0 0 1 15 0",
  // Brief / Bericht
  "M4 6.5h16v11H4zM4.5 7l7.5 6 7.5-6",
];
---

<section id="leistungen" class="abschnitt pt-0" aria-labelledby="leistungen-titel">
  <div class="behaelter flex flex-col gap-[clamp(1.75rem,4vw,3.5rem)]">
    <Kopf id="leistungen-titel" kicker={l.kicker} titel={l.titel} />
    <ul class="wischen grid gap-[clamp(0.75rem,1.6vw,1.25rem)] sm:grid-cols-2 lg:grid-cols-3">
      {
        l.karten.map((karte, i) => (
          <li class="reveal flex flex-col gap-4 rounded-3xl bg-karte p-[clamp(1.375rem,2.6vw,2rem)]">
            <span class="grid size-11 shrink-0 place-items-center rounded-[11px_11px_11px_3px] bg-akzent text-white" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <path d={symbole[i % symbole.length]} />
              </svg>
            </span>
            <div>
              <h3 class="text-[1.25rem]">{karte.titel}</h3>
              <p class="mt-2 text-leise">{karte.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
