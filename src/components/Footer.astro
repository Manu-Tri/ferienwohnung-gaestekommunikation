---
import { site } from "../config/laden";
import { pfad } from "../config/pfad";
import Logo from "./Logo.astro";
const jahr = new Date().getFullYear();
---

<footer class="fuss border-t border-auf-tinte/15 bg-tinte text-auf-tinte-leise">
  <div class="behaelter flex flex-wrap items-center gap-x-7 gap-y-4 py-7 text-[0.94rem] font-medium">
    <div class="text-auf-tinte [--logo-blase:var(--akzent)]">
      <Logo klein />
    </div>
    <nav aria-label="Angebot" class="contents">
      <a href={pfad("/inserats-check")}>Inserats-Check</a>
      <a href={pfad("/#preise")}>Preise</a>
      <a href={pfad("/#agenturen")}>Für Agenturen</a>
    </nav>
    <span class="hidden flex-1 md:block"></span>
    <nav aria-label="Rechtliches und Kontakt" class="contents">
      <a href={`mailto:${site.marke.email}`}>{site.marke.email}</a>
      <a href={pfad("/impressum")}>Impressum</a>
      <a href={pfad("/datenschutz")}>Datenschutz</a>
    </nav>
  </div>
  <div class="behaelter flex flex-col gap-2 border-t border-auf-tinte/10 pt-5 pb-24 text-sm md:flex-row md:justify-between md:pb-5">
    <p>© {jahr} {site.marke.name}{site.marke.ort && `, ${site.marke.ort}`}</p>
    <p class="max-w-2xl md:text-right">{site.footer.hinweis_marken}</p>
  </div>
</footer>

<style>
  .fuss {
    --fokus: var(--mint);
  }
  .fuss a {
    color: var(--auf-tinte-leise);
  }
  .fuss a:hover {
    color: var(--auf-tinte);
  }
</style>
