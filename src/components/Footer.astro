---
import { site } from "../config/laden";
import { pfad } from "../config/pfad";
import Logo from "./Logo.astro";
const jahr = new Date().getFullYear();
---

<footer class="border-t border-linie bg-karte">
  <div class="behaelter grid gap-10 py-12 text-[0.95rem] md:grid-cols-[1.4fr_1fr_1fr] md:py-14">
    <div class="space-y-3">
      <Logo />
      <p class="max-w-xs font-medium">Ihre Gäste bekommen immer eine Antwort.</p>
      <p class="text-leise">{site.marke.ort}</p>
    </div>
    <nav aria-label="Angebot">
      <p class="text-sm font-bold">Angebot</p>
      <ul class="mt-3 space-y-2">
        <li><a class="text-text" href={pfad("/inserats-check")}>Kostenloser Inserats-Check</a></li>
        <li><a class="text-text" href={pfad("/#preise")}>Preise</a></li>
        <li><a class="text-text" href={pfad("/#agenturen")}>Für Agenturen</a></li>
      </ul>
    </nav>
    <nav aria-label="Rechtliches und Kontakt">
      <p class="text-sm font-bold">Kontakt und Rechtliches</p>
      <ul class="mt-3 space-y-2">
        <li><a class="text-text" href={`mailto:${site.marke.email}`}>{site.marke.email}</a></li>
        <li><a class="text-text" href={pfad("/impressum")}>Impressum</a></li>
        <li><a class="text-text" href={pfad("/datenschutz")}>Datenschutz</a></li>
      </ul>
    </nav>
  </div>
  <div class="behaelter flex flex-col gap-2 border-t border-linie py-5 text-sm text-leise md:flex-row md:justify-between">
    <p>© {jahr} {site.marke.name}</p>
    <p class="max-w-2xl md:text-right">{site.footer.hinweis_marken}</p>
  </div>
</footer>
