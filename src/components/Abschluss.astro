---
import { site } from "../config/laden";
const a = site.abschluss;
// Satz nach dem ersten Punkt leuchtet in Mint
const trenner = a.titel.indexOf(". ");
const satz1 = trenner > 0 ? a.titel.slice(0, trenner + 1) : a.titel;
const satz2 = trenner > 0 ? a.titel.slice(trenner + 2) : "";
---

<section class="abschluss bg-tinte text-auf-tinte" aria-labelledby="abschluss-titel" data-ohne-leiste>
  <div class="behaelter reveal flex flex-col items-start gap-[clamp(1.25rem,3vw,2rem)] py-[clamp(4rem,9vw,8rem)]">
    {a.kicker && <p class="kicker !text-gold">{a.kicker}</p>}
    <h2 id="abschluss-titel" class="max-w-[62.5rem] text-[clamp(2.25rem,5.4vw,5rem)] leading-[0.92] font-extrabold tracking-[-0.04em]">
      {satz1}
      {satz2 && <> <span class="text-mint">{satz2}</span></>}
    </h2>
    <p class="max-w-[42rem] text-[clamp(1rem,1.5vw,1.19rem)] leading-relaxed text-auf-tinte-leise">{a.text}</p>
    <div class="flex flex-wrap items-center gap-x-[1.375rem] gap-y-3">
      <a href="#anfrage" data-anliegen="test" class="knopf knopf-mint !px-7 !py-[1.125rem] text-lg">{site.cta.test}</a>
      <a href="#anfrage" data-anliegen="check" class="textlink text-auf-tinte hover:text-mint">{site.cta.check}</a>
    </div>
  </div>
</section>

<style>
  .abschluss {
    --fokus: var(--mint);
  }
  /* Auf dem dunklen Grund: Mint mit dunkler Schrift, damit der Knopf leuchtet */
  .knopf-mint {
    background: var(--mint);
    color: var(--tinte);
    box-shadow: 0 4px 0 var(--mint-schatten);
  }
  .knopf-mint:hover {
    background: #a6dfb8;
    color: var(--tinte);
  }
</style>
