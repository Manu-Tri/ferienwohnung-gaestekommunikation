---
/**
 * Bildmarke: Sprechblase mit zwei vollständigen Häkchen nebeneinander (gelesen und beantwortet), mittig gesetzt.
 * Farben über --logo-blase und --logo-haken anpassbar (z. B. im dunklen Abschlussbereich).
 */
interface Props {
  groesse?: number;
  class?: string;
}
const { groesse = 34, class: klasse = "" } = Astro.props;
const blase = "M10 2.5h12A8 8 0 0 1 30 10.5v6a8 8 0 0 1-8 8h-8.6l-6.1 4.9c-.8.6-1.8.1-1.8-.9v-4.6A8 8 0 0 1 2 16.5v-6a8 8 0 0 1 8-8z";
const haken = "M9.3 13.9l2 2 4.4-4.8M16.3 13.9l2 2 4.4-4.8";
---

<svg width={groesse} height={groesse} viewBox="0 0 32 32" aria-hidden="true" class:list={["logo-zeichen shrink-0", klasse]}>
  <path d={blase} style="fill: var(--logo-blase, #109c4c)"></path>
  <g fill="none" stroke-linecap="round" stroke-linejoin="round">
    <path d={haken} stroke-width="2.1" style="stroke: var(--logo-haken, #fff)"></path>
  </g>
</svg>
